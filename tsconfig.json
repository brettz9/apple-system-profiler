{
  "compilerOptions": {
    "lib": ["es2024", "DOM"],
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "target": "es2024"
  },
  "include": [
    "*.js"
  ],
  "exclude": ["node_modules"]
}
